+/***************** seek/tell *******************/
+
+/*
+ * Reposition / report / probe the byte offset of a file handle.  Only real
+ * files are seekable (the BFILE_file transducer, possibly under a utf8 layer);
+ * pipes, in-memory and compression transducers are not.  Offsets are byte
+ * offsets in the underlying file.
+ * whence: 0 = AbsoluteSeek (SEEK_SET), 1 = RelativeSeek (SEEK_CUR),
+ *         2 = SeekFromEnd (SEEK_END).
+ */
+void
+seekb(BFILE *p, value_t offset, int whence)
+{
+#if WANT_STDIO
+  if (p->getb == getb_file) {
+    int w = whence == 0 ? SEEK_SET : whence == 1 ? SEEK_CUR : SEEK_END;
+    if (fseeko(((struct BFILE_file *)p)->file, (off_t)offset, w))
+      ERR("seekb: fseeko failed");
+    return;
+  }
+#endif
+#if WANT_UTF8
+  if (p->getb == getb_utf8) {
+    struct BFILE_utf8 *u = (struct BFILE_utf8 *)p;
+    u->unget = -1;
+    seekb(u->bfile, offset, whence);
+    return;
+  }
+#endif
+  ERR("seekb: handle not seekable");
+}
+
+value_t
+tellb(BFILE *p)
+{
+#if WANT_STDIO
+  if (p->getb == getb_file)
+    return (value_t)ftello(((struct BFILE_file *)p)->file);
+#endif
+#if WANT_UTF8
+  if (p->getb == getb_utf8) {
+    struct BFILE_utf8 *u = (struct BFILE_utf8 *)p;
+    if (u->unget >= 0)
+      ERR("tellb: pending unget");
+    return tellb(u->bfile);
+  }
+#endif
+  ERR("tellb: handle not seekable");
+  return -1;
+}
+
+/* Probe whether a handle supports seeking, without disturbing its state. */
+value_t
+seekableb(BFILE *p)
+{
+#if WANT_STDIO
+  if (p->getb == getb_file)
+    return ftello(((struct BFILE_file *)p)->file) >= 0;   /* fails (ESPIPE) on pipes */
+#endif
+#if WANT_UTF8
+  if (p->getb == getb_utf8)
+    return seekableb(((struct BFILE_utf8 *)p)->bfile);
+#endif
+  return 0;
+}
+
