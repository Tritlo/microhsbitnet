+-- | Whether the handle supports seeking.  Probes the underlying stream
+-- (regular files and in-memory buffers are seekable; pipes/terminals are not).
 hIsSeekable :: Handle -> IO Bool
-hIsSeekable _ = return False
+hIsSeekable h = withHandleAny h $ \ p -> (/= (0 :: Int)) <$> c_seekableb p
+
+foreign import ccall "seekb"     c_seekb     :: Ptr BFILE -> Int -> Int -> IO ()
+foreign import ccall "tellb"     c_tellb     :: Ptr BFILE -> IO Int
+foreign import ccall "seekableb" c_seekableb :: Ptr BFILE -> IO Int
+
+-- Run an action on a handle's stream, raising an @IllegalOperation@ IOError
+-- (catchable) rather than aborting if the handle is not seekable.
+withSeekable :: forall a . String -> Handle -> (Ptr BFILE -> IO a) -> IO a
+withSeekable loc h act = withHandleAny h $ \ p -> do
+  ok <- c_seekableb p
+  if ok == (0 :: Int)
+    then ioError (mkIOError illegalOperationErrorType loc (Just h) Nothing)
+    else act p
+
+-- | Set the byte position of a handle.  @SeekMode@ selects absolute, relative,
+-- or from-the-end positioning.  Raises an @IllegalOperation@ error if the
+-- handle is not seekable.
+hSeek :: Handle -> SeekMode -> Integer -> IO ()
+hSeek h mode pos = withSeekable "hSeek" h $ \ p -> c_seekb p (fromInteger pos) (fromEnum mode)
+
+-- | The current byte position of a handle.
+hTell :: Handle -> IO Integer
+hTell h = withSeekable "hTell" h $ \ p -> toInteger <$> c_tellb p
+
+-- | The size, in bytes, of the file behind a handle.
+hFileSize :: Handle -> IO Integer
+hFileSize h = withSeekable "hFileSize" h $ \ p -> do
+  cur <- c_tellb p
+  c_seekb p 0 (fromEnum SeekFromEnd)
+  sz <- c_tellb p
+  c_seekb p cur (fromEnum AbsoluteSeek)
+  return (toInteger sz)
 
