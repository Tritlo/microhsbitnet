{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "types": ["@webgpu/types", "node"],
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
